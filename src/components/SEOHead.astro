---
export interface Props {
  title: string;
  description: string;
  canonicalURL?: string | URL;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishDate?: Date;
  modifiedDate?: Date;
  author?: string;
  noindex?: boolean;
  tags?: string[];
}

const SITE_NAME = 'XcaliGames';
const SITE_URL = Astro.site ? Astro.site.origin : 'https://xcaligames.cloud';

const {
  title,
  description,
  canonicalURL,
  ogImage = '/og-default.webp',
  ogType = 'website',
  publishDate,
  modifiedDate,
  author = 'XcaliGames Studio',
  noindex = false,
  tags = [],
} = Astro.props;

// Limpieza estricta de Canonical URL: sin query params ni barra final (excepto raíz "/")
const rawPath = Astro.url.pathname.replace(/\.html$/, '');
const cleanPathname =
  rawPath.length > 1 && rawPath.endsWith('/') ? rawPath.slice(0, -1) : rawPath;

const resolvedCanonical = canonicalURL
  ? new URL(canonicalURL.toString(), SITE_URL).href
  : new URL(cleanPathname, SITE_URL).href;

// Ruta absoluta obligatoria para Open Graph y Twitter Image
const absoluteOgImage = new URL(ogImage, SITE_URL).href;

// Plantilla de título optimizada para SERPs
const formattedTitle = title.includes(SITE_NAME) ? title : `${title} | ${SITE_NAME}`;

const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

// Construcción dinámica de JSON-LD Schema.org
const isHome = cleanPathname === '/';

const websiteAndOrgSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: SITE_NAME,
      description:
        'Estudio independiente de videojuegos en México, creador de Torchbound (solitario de mazmorra en 3D con reto diario) y Riserift.',
      inLanguage: 'es-MX',
      publisher: {
        '@id': `${SITE_URL}/#organization`,
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE_URL}/#organization`,
      name: SITE_NAME,
      url: SITE_URL,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE_URL}/favicon.svg`,
      },
      sameAs: [
        'https://play.google.com/store/apps/details?id=com.xcaligames.torchbound',
      ],
    },
    {
      '@type': 'VideoGame',
      name: 'Torchbound',
      url: 'https://play.google.com/store/apps/details?id=com.xcaligames.torchbound',
      description:
        'Solitario de mazmorra en 3D basado en Scoundrel, con un reto diario igual para todo el mundo y tablero mundial.',
      genre: ['Juego de cartas', 'Roguelike', 'Solitario'],
      gamePlatform: 'Android',
      operatingSystem: 'Android',
      applicationCategory: 'GameApplication',
      inLanguage: ['es', 'en'],
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: {
        '@id': `${SITE_URL}/#organization`,
      },
    },
  ],
};

const blogPostingAndBreadcrumbSchema =
  ogType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          {
            '@type': 'BlogPosting',
            headline: title,
            description: description,
            image: [absoluteOgImage],
            datePublished: publishDate ? publishDate.toISOString() : undefined,
            dateModified: (modifiedDate || publishDate)?.toISOString(),
            author: {
              '@type': 'Organization',
              name: author,
              url: SITE_URL,
            },
            publisher: {
              '@type': 'Organization',
              name: SITE_NAME,
              logo: {
                '@type': 'ImageObject',
                url: `${SITE_URL}/favicon.svg`,
              },
            },
            keywords: tags.join(', '),
            mainEntityOfPage: {
              '@type': 'WebPage',
              '@id': resolvedCanonical,
            },
            inLanguage: 'es-MX',
          },
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Inicio',
                item: SITE_URL,
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: 'Blog',
                item: `${SITE_URL}/blog`,
              },
              {
                '@type': 'ListItem',
                position: 3,
                name: title,
                item: resolvedCanonical,
              },
            ],
          },
        ],
      }
    : null;

const activeSchema =
  ogType === 'article'
    ? blogPostingAndBreadcrumbSchema
    : isHome
      ? websiteAndOrgSchema
      : {
          '@context': 'https://schema.org',
          '@type': 'WebPage',
          name: formattedTitle,
          description: description,
          url: resolvedCanonical,
          inLanguage: 'es-MX',
        };
---

<!-- 1. Metadatos Base -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{formattedTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />
<meta name="generator" content={Astro.generator} />
<meta name="theme-color" content="#0A0C14" />

<!-- Preload de fuentes locales (.woff2) para evitar FOUT/CLS y alcanzar 100/100 en LCP -->
<link
  rel="preload"
  href="/fonts/cinzel-latin-600-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>
<link
  rel="preload"
  href="/fonts/alegreya-sans-latin-500-normal.woff2"
  as="font"
  type="font/woff2"
  crossorigin="anonymous"
/>

<!-- Favicons y RSS -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE_NAME} | Devlog & Blog RSS Feed`}
  href={new URL('/rss.xml', SITE_URL).href}
/>

<!-- 2. Canonical URL -->
<link rel="canonical" href={resolvedCanonical} />

<!-- 3. Open Graph (Facebook / LinkedIn / WhatsApp / Discord) -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:locale" content="es_MX" />

{
  ogType === 'article' && publishDate && (
    <meta property="article:published_time" content={publishDate.toISOString()} />
  )
}
{
  ogType === 'article' && (modifiedDate || publishDate) && (
    <meta
      property="article:modified_time"
      content={(modifiedDate || publishDate)!.toISOString()}
    />
  )
}
{
  ogType === 'article' &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}

<!-- 4. Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />

<!-- 5. Datos Estructurados (JSON-LD Schema.org) -->
{
  !noindex && activeSchema && (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(activeSchema)}
    />
  )
}

