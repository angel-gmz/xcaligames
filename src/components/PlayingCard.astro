---
// Carta física con el mismo estilo que las cartas de Torchbound.
export interface Props {
  kind: 'monster' | 'weapon' | 'potion' | 'flee';
  value?: string;
  suit?: string;
  label?: string;
  class?: string;
  style?: string;
  size?: 'sm' | 'md' | 'lg';
}
const { kind, value, suit = '', label, class: cls = '', style, size = 'md' } = Astro.props;
const sizes = {
  sm: 'w-24 h-34 text-4xl',
  md: 'w-32 h-[11.2rem] text-5xl',
  lg: 'w-40 h-56 text-6xl',
};
const red = suit === '♥' || suit === '♦';
---

<div class:list={['card relative flex shrink-0 flex-col items-center justify-center', `card-${kind}`, sizes[size], cls]} style={style} aria-hidden="true">
  <span class:list={['absolute left-2.5 top-1.5 font-display text-lg leading-none', red ? 'text-[#B8322A]' : 'text-[#2A1A20]']}>
    {value}<br />{suit}
  </span>
  <span class="font-display leading-none">{value ?? ''}</span>
  <span class:list={['text-[0.55em] leading-tight', red ? 'text-[#B8322A]' : 'text-[#2A1A20]']}>{suit}</span>
  {label && (
    <span class="absolute inset-x-2 bottom-2 rounded-md py-0.5 text-center text-[13px] font-extrabold text-white" style="background: var(--suit)">
      {label}
    </span>
  )}
  <slot />
</div>
