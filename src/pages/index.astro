---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PlayingCard from '../components/PlayingCard.astro';

import riseriftImg from '../assets/images/riserift-cover.png';
import shot1 from '../assets/images/torchbound/captura-1.jpg';
import shot2 from '../assets/images/torchbound/captura-2.jpg';
import shot3 from '../assets/images/torchbound/captura-3.jpg';
import shot4 from '../assets/images/torchbound/captura-4.jpg';
import shot5 from '../assets/images/torchbound/captura-5.jpg';
import shot6 from '../assets/images/torchbound/captura-6.jpg';
import partida from '../assets/images/torchbound/partida.jpg';

const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.xcaligames.torchbound';

const allPosts = await getCollection('blog', ({ data }) => {
  return import.meta.env.PROD ? data.draft !== true : true;
});
const latestPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);

const gallery = [
  { src: shot1, alt: 'Pantalla de inicio de Torchbound con los modos Aventura y Desafío diario' },
  { src: shot2, alt: 'Antes de cada golpe, el juego muestra cuánto daño recibirás con arma o a mano' },
  { src: shot3, alt: 'Un demonio y un ogro salen de sus cartas sobre la mesa de la mazmorra' },
  { src: shot4, alt: 'Selección de héroes del modo Aventura: Vagabundo, Pícaro y Guerrero' },
  { src: shot5, alt: 'Ficha del dragón en el bestiario' },
  { src: shot6, alt: 'Lista de logros desbloqueados' },
];

const rules = [
  {
    kind: 'monster' as const, value: '8', suit: '♠', label: 'Monstruo',
    title: 'Monstruos', text: 'Picas y tréboles. Te hacen daño igual a su valor: J vale 11, Q 12, K 13 y A 14.',
  },
  {
    kind: 'weapon' as const, value: '5', suit: '♦', label: 'Arma',
    title: 'Armas', text: 'Diamantes. Restan su valor al daño, pero después de matar solo sirven contra monstruos más pequeños.',
  },
  {
    kind: 'potion' as const, value: '4', suit: '♥', label: 'Poción',
    title: 'Pociones', text: 'Corazones. Te curan hasta 20 de vida, y solo una por sala hace efecto.',
  },
];
---

<BaseLayout
  title="Xcali Games | Torchbound, el solitario de mazmorra con reto diario"
  description="Xcali Games es un estudio indie en México. Juega Torchbound gratis en Android: un solitario de mazmorra en 3D basado en Scoundrel, con una mazmorra nueva cada día para todo el mundo."
>
  <!-- Hero: Torchbound -->
  <section id="torchbound" class="overflow-hidden" aria-labelledby="heading-hero">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-12 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-12 lg:px-8 lg:pt-20">
      <div class="lg:col-span-7">
        <p class="inline-flex items-center gap-2 rounded-full border border-gold/40 bg-gold/10 px-4 py-1.5 text-[15px] font-bold text-gold">
          <span class="h-2 w-2 rounded-full bg-ember"></span>
          Ya disponible en Android
        </p>
        <h1 id="heading-hero" class="mt-6 text-5xl leading-[1.04] text-parchment sm:text-6xl lg:text-7xl">
          Una antorcha. 44 cartas. Una mazmorra.
        </h1>
        <p class="mt-6 max-w-[34rem] text-xl leading-relaxed text-ash">
          Torchbound es un solitario de mazmorra en 3D basado en Scoundrel. Lucha, huye o cúrate en partidas de cinco minutos, y cada día enfrenta la misma mazmorra que el resto del mundo.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-x-6 gap-y-4">
          <a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="btn-ember inline-flex min-h-14 items-center gap-3 rounded-full px-7 text-lg font-extrabold transition">
            <svg class="h-5 w-5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/></svg>
            Descargar en Google Play
          </a>
          <a href="#como-se-juega" class="rounded-lg py-2 text-lg font-bold text-parchment underline decoration-gold/60 underline-offset-[6px] hover:text-gold">
            Cómo se juega
          </a>
        </div>
        <p class="mt-5 text-[15px] text-ash/80">Gratis, sin conexión y sin pagar para ganar.</p>
      </div>

      <!-- Teléfono con el juego y la mano de cartas -->
      <div class="relative mx-auto w-full max-w-sm lg:col-span-5">
        <div class="absolute -inset-10 rounded-full bg-ember/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative rotate-2 overflow-hidden rounded-[2.2rem] border-[6px] border-[#2A2230] bg-black shadow-2xl shadow-black/60">
          <Image src={partida} alt="Partida de Torchbound: un demonio y un ogro salen de sus cartas sobre la mesa" width={420} height={714} format="webp" loading="eager" fetchpriority="high" class="h-auto w-full" />
        </div>
        <div class="absolute -bottom-10 left-1 flex sm:-left-16" aria-hidden="true">
          <PlayingCard kind="weapon" value="7" suit="♦" size="sm" class="deal" style="--r:-14deg;--r0:-30deg;--d:150ms" />
          <PlayingCard kind="monster" value="13" suit="♠" size="sm" class="deal -ml-8 -translate-y-4" style="--r:-2deg;--r0:-10deg;--d:300ms" />
          <PlayingCard kind="potion" value="6" suit="♥" size="sm" class="deal -ml-8" style="--r:11deg;--r0:25deg;--d:450ms" />
        </div>
      </div>
    </div>
  </section>

  <!-- Reglas -->
  <section id="como-se-juega" class="border-t border-line/60 bg-crypt/60 py-20 sm:py-24" aria-labelledby="heading-reglas">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <h2 id="heading-reglas" class="max-w-2xl text-4xl leading-tight text-parchment sm:text-5xl">Se aprende en un minuto</h2>
      <p class="mt-4 max-w-2xl text-xl leading-relaxed text-ash">
        Cada sala tiene cuatro cartas. Juegas tres y la cuarta se queda para la siguiente. Vacía el mazo antes de que tu vida llegue a cero.
      </p>

      <ul class="mt-14 grid grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
        {rules.map((r) => (
          <li class="flex gap-5 lg:flex-col">
            <PlayingCard kind={r.kind} value={r.value} suit={r.suit} label={r.label} size="md" />
            <div>
              <h3 class="text-2xl text-parchment">{r.title}</h3>
              <p class="mt-2 text-[17px] leading-relaxed text-ash">{r.text}</p>
            </div>
          </li>
        ))}
        <li class="flex gap-5 lg:flex-col">
          <div class="card card-flee flex h-[11.2rem] w-32 shrink-0 items-center justify-center text-6xl" aria-hidden="true">🏃</div>
          <div>
            <h3 class="text-2xl text-parchment">Huir</h3>
            <p class="mt-2 text-[17px] leading-relaxed text-ash">Si la sala pinta mal, mándala al fondo del mazo. Nunca dos veces seguidas.</p>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <!-- Reto diario -->
  <section class="py-20 sm:py-24" aria-labelledby="heading-reto">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-7">
        <h2 id="heading-reto" class="text-4xl leading-tight text-parchment sm:text-5xl">La misma mazmorra para todo el mundo, cada día</h2>
        <p class="mt-5 max-w-xl text-xl leading-relaxed text-ash">
          El reto diario reparte las mismas cartas a todos los jugadores. Tu mejor puntuación entra al tablero mundial de Google Play Games, y al terminar puedes compartir tu partida sala por sala, sin revelar las cartas.
        </p>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ash/85">
          Una mazmorra nueva se abre cada noche (a la 1:00 a.&nbsp;m., hora del centro de México). Juégala varios días seguidos para mantener tu racha.
        </p>
      </div>
      <figure class="lg:col-span-5">
        <div class="max-w-sm rounded-3xl rounded-bl-md border border-line bg-crypt-2 p-6 text-xl leading-relaxed text-parchment shadow-xl shadow-black/40">
          <p class="font-bold">Torchbound · Desafío del 5 nov</p>
          <p class="mt-1">🔥 Escapé con 14 puntos (14 de vida)</p>
          <p class="mt-3 text-2xl tracking-[0.12em]" aria-hidden="true">🟩🟩🟨🏃🟩🟥🟩🟩<br />🟩🟨🟩🟩</p>
          <p class="mt-3">Racha: 3 días</p>
          <p class="mt-1 text-gold">¿Puedes superarme?</p>
        </div>
        <figcaption class="mt-4 max-w-sm text-[15px] leading-relaxed text-ash/80">
          Así se ve un resultado compartido. Cada cuadro es una sala: verde sin daño, amarillo daño leve, rojo daño fuerte; 🏃 es una huida.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Galería -->
  <section class="border-t border-line/60 bg-crypt/60 py-20 sm:py-24" aria-labelledby="heading-galeria">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl">
          <h2 id="heading-galeria" class="text-4xl leading-tight text-parchment sm:text-5xl">Más que el reto del día</h2>
          <p class="mt-4 text-xl leading-relaxed text-ash">
            Cinco héroes que cambian una regla cada uno en el modo Aventura, monstruos en 3D que salen de sus cartas, un bestiario por completar y 17 logros.
          </p>
        </div>
        <a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="btn-ember inline-flex min-h-12 items-center rounded-full px-6 font-extrabold transition">
          Jugar gratis
        </a>
      </div>
    </div>
    <ul class="mx-auto mt-12 flex max-w-6xl snap-x snap-mandatory scroll-px-4 gap-5 overflow-x-auto px-4 pb-4 sm:px-6 lg:px-8" aria-label="Capturas de Torchbound">
      {gallery.map((g) => (
        <li class="w-56 shrink-0 snap-start sm:w-64">
          <Image src={g.src} alt={g.alt} width={320} height={569} format="webp" loading="lazy" class="h-auto w-full rounded-2xl border border-line" />
        </li>
      ))}
    </ul>
  </section>

  <!-- Riserift -->
  <section id="riserift" class="py-20 sm:py-24" aria-labelledby="heading-riserift">
    <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-4 sm:px-6 lg:grid-cols-12 lg:px-8">
      <div class="lg:col-span-5">
        <Image src={riseriftImg} alt="Arte conceptual de Riserift" width={800} height={450} format="webp" loading="lazy" class="h-auto w-full rounded-2xl border border-rift/30" />
      </div>
      <div class="lg:col-span-7">
        <p class="inline-flex rounded-full border border-rift/40 bg-rift/10 px-4 py-1.5 text-[15px] font-bold text-rift">En desarrollo</p>
        <h2 id="heading-riserift" class="mt-4 text-4xl leading-tight text-parchment sm:text-5xl">Riserift</h2>
        <p class="mt-4 max-w-xl text-xl leading-relaxed text-ash">
          Nuestro siguiente juego. En Riserift la realidad se quiebra en medio del combate: atraviesa grietas dimensionales, encadena habilidades y adáptate a escenarios que cambian sus reglas en cada ascenso.
        </p>
        <a href="/blog" class="mt-6 inline-block rounded-lg py-2 text-lg font-bold text-rift underline decoration-rift/50 underline-offset-[6px] hover:text-parchment">
          Sigue su desarrollo en el devlog
        </a>
      </div>
    </div>
  </section>

  <!-- Devlog -->
  <section class="border-t border-line/60 py-20 sm:py-24" aria-labelledby="heading-blog">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h2 id="heading-blog" class="text-4xl leading-tight text-parchment sm:text-5xl">Del devlog</h2>
        <a href="/blog" class="rounded-lg py-2 text-lg font-bold text-gold underline decoration-gold/50 underline-offset-[6px] hover:text-parchment">Ver todas las entradas</a>
      </div>
      <div class="mt-10 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
        {latestPosts.map((post) => (
          <article class="flex flex-col overflow-hidden rounded-2xl border border-line bg-crypt">
            <a href={`/blog/${post.id}`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <Image src={post.data.heroImage} alt="" width={600} height={315} format="webp" loading="lazy" class="h-48 w-full object-cover" />
            </a>
            <div class="flex flex-1 flex-col p-6">
              <time datetime={post.data.pubDate.toISOString()} class="text-[15px] text-ash/80">{formatDate(post.data.pubDate)}</time>
              <h3 class="mt-2 text-xl leading-snug text-parchment">
                <a href={`/blog/${post.id}`} class="hover:text-gold">{post.data.title}</a>
              </h3>
              <p class="mt-3 line-clamp-3 leading-relaxed text-ash">{post.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
