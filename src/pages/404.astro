---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Página no encontrada"
  description="La página que buscas no existe en xcaligames.cloud."
  noindex={true}
>
  <section class="mx-auto flex max-w-3xl flex-col items-center px-4 py-28 text-center sm:px-6">
    <div class="card card-monster flex h-40 w-28 rotate-[-6deg] items-center justify-center font-display text-5xl" aria-hidden="true">404</div>
    <h1 class="mt-10 text-4xl leading-tight text-parchment sm:text-5xl">Tu antorcha no alumbra esta sala</h1>
    <p class="mt-4 max-w-xl text-xl leading-relaxed text-ash">
      Esta página no existe o cambió de lugar. Vuelve al inicio o revisa el devlog.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-ember inline-flex min-h-12 items-center rounded-full px-7 font-extrabold transition">Volver al inicio</a>
      <a href="/blog" class="inline-flex min-h-12 items-center rounded-full border border-line px-7 font-bold text-parchment transition hover:border-gold hover:text-gold">Ir al devlog</a>
    </div>
  </section>
</BaseLayout>
