---
import SEOHead from '../components/SEOHead.astro';
import '../styles/global.css';
import coverImg from '../assets/images/vitrales-de-fe-cover.png';

const title = 'Vitrales de Fe — Lectura bíblica diaria sin culpas';
const description =
  'Proyecto de apoyo a la comunidad de Xcali Games: ilumina 15 vitrales góticos pieza a pieza, lee la Biblia completa de 66 libros offline y comparte postales sin anuncios.';
---

<!doctype html>
<html lang="es-MX">
  <head>
    <SEOHead title={title} description={description} ogImage={coverImg.src} />
  </head>
  <body class="vf-body">
    <header class="vf-topbar">
      <div class="vf-topbar-inner">
        <div class="vf-brand-group">
          <a href="#inicio" class="vf-brand">
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5.5 21V11.6c0-4.3 3-7.2 6.5-9.1 3.5 1.9 6.5 4.8 6.5 9.1V21Z" fill="#090910" />
              <path d="M6.8 19.6V12.5H11.4V19.6Z" fill="#3E7BFA" />
              <path d="M12.6 19.6V12.5H17.2V19.6Z" fill="#F5C451" />
              <path d="M6.8 11.4c.2-3 2.1-5.4 4.6-7.1v7.1Z" fill="#D94B43" />
              <path d="M17.2 11.4h-4.6V4.3c2.5 1.7 4.4 4.1 4.6 7.1Z" fill="#2E9E73" />
            </svg>
            Vitrales de Fe
          </a>
          <a href="/" class="vf-studio-badge" aria-label="Volver al inicio de Xcali Games">
            ← Xcali Games
          </a>
        </div>

        <nav class="vf-nav" aria-label="Navegación de Vitrales de Fe">
          <a href="#experiencia">Cómo funciona</a>
          <a href="#vitrales">15 Vitrales</a>
          <a href="#biblia">Biblia y Postales</a>
          <a href="/vitrales-de-fe-privacidad">Privacidad</a>
          <a href="/blog/vitrales-de-fe" class="vf-nav-cta">Leer nota del proyecto</a>
        </nav>
      </div>
    </header>

    <main id="inicio">
      <section class="vf-hero">
        <div class="vf-hero-inner">
          <div>
            <span class="vf-eyebrow">Apoyo a la comunidad · Offline · Sin anuncios</span>
            <h1 class="vf-h1">
              Un <em>vitral de luz</em> que crece con cada lectura bíblica.
            </h1>
            <p class="vf-hero-copy">
              Vitrales de Fe transforma tu momento diario con la Escritura en una experiencia serena y visual.
              Elige cómo llega tu corazón, descubre un pasaje, escribe una breve reflexión e ilumina una nueva
              pieza de vidrio en tu colección.
            </p>

            <div class="vf-mood-pills" aria-label="Cinco estados de ánimo">
              <span class="vf-mood-pill"><span class="vf-mood-dot" style="background:#7DB4EE"></span>Buscando paz</span>
              <span class="vf-mood-pill"><span class="vf-mood-dot" style="background:#E0566A"></span>Necesito fuerza</span>
              <span class="vf-mood-pill"><span class="vf-mood-dot" style="background:#F2B441"></span>Agradecido</span>
              <span class="vf-mood-pill"><span class="vf-mood-dot" style="background:#56BE92"></span>Con esperanza</span>
              <span class="vf-mood-pill"><span class="vf-mood-dot" style="background:#A488EA"></span>Sabiduría</span>
            </div>

            <div class="vf-hero-actions">
              <a href="#vitrales" class="vf-btn-gold">Explorar los 15 vitrales</a>
              <a href="/blog/vitrales-de-fe" class="vf-btn-outline-light">Leer nota en el devlog →</a>
            </div>

            <div class="vf-hero-stats">
              <div>
                <div class="vf-stat-num">15 vitrales</div>
                <div class="vf-stat-label">235 piezas únicas dibujadas en SVG</div>
              </div>
              <div>
                <div class="vf-stat-num">66 libros</div>
                <div class="vf-stat-label">1,189 capítulos offline (VBL)</div>
              </div>
              <div>
                <div class="vf-stat-num">0 anuncios</div>
                <div class="vf-stat-label">100 % privada en tu dispositivo</div>
              </div>
            </div>
          </div>

          <div class="vf-stage" aria-label="Demostración interactiva del vitral">
            <div class="vf-stage-header">
              <span class="vf-stage-title">El Alba de la Creación</span>
              <span class="vf-stage-counter" id="demo-counter">4 / 9 cuadros</span>
            </div>

            <div class="vf-arch-frame">
              <div class="vf-arch-inner">
                <svg id="demo-mural-svg" viewBox="0 0 300 400" role="img" aria-label="Vitral interactivo El Alba de la Creación">
                  <rect x="0" y="0" width="300" height="400" fill="#090910" />

                  <g class="vf-mural-tile vf-tile-lit" data-tile="0">
                    <rect x="6" y="6" width="92" height="124" fill="#213878" />
                    <path d="M6 70 Q52 24 98 70 L98 130 L6 130 Z" fill="#3256B5" />
                  </g>
                  <g class="vf-mural-tile vf-tile-lit" data-tile="1">
                    <rect x="104" y="6" width="92" height="124" fill="#2A468E" />
                    <circle cx="150" cy="74" r="30" fill="#F5C451" />
                    <circle cx="150" cy="74" r="16" fill="#FFE699" />
                  </g>
                  <g class="vf-mural-tile vf-tile-lit" data-tile="2">
                    <rect x="202" y="6" width="92" height="124" fill="#1C2C63" />
                    <path d="M202 88 Q248 40 294 88 L294 130 L202 130 Z" fill="#463E8C" />
                  </g>

                  <g class="vf-mural-tile vf-tile-lit" data-tile="3">
                    <rect x="6" y="136" width="92" height="128" fill="#8D3B32" />
                    <path d="M6 210 L98 158 L98 264 L6 264 Z" fill="#D96B43" />
                  </g>
                  <g class="vf-mural-tile vf-tile-dark" data-tile="4">
                    <rect x="104" y="136" width="92" height="128" fill="#C9732B" />
                    <circle cx="150" cy="200" r="36" fill="#F5C451" />
                    <circle cx="150" cy="200" r="18" fill="#FFF3C4" />
                  </g>
                  <g class="vf-mural-tile vf-tile-dark" data-tile="5">
                    <rect x="202" y="136" width="92" height="128" fill="#7D334A" />
                    <path d="M202 158 L294 210 L294 264 L202 264 Z" fill="#E38A42" />
                  </g>

                  <g class="vf-mural-tile vf-tile-dark" data-tile="6">
                    <rect x="6" y="270" width="92" height="124" fill="#1B4D7A" />
                    <path d="M6 312 Q52 292 98 312 L98 394 L6 394 Z" fill="#3B82B8" />
                  </g>
                  <g class="vf-mural-tile vf-tile-dark" data-tile="7">
                    <rect x="104" y="270" width="92" height="124" fill="#235E8C" />
                    <path d="M126 270 L174 270 L188 394 L112 394 Z" fill="#F5C451" opacity="0.82" />
                  </g>
                  <g class="vf-mural-tile vf-tile-dark" data-tile="8">
                    <rect x="202" y="270" width="92" height="124" fill="#17416B" />
                    <path d="M202 312 Q248 292 294 312 L294 394 L202 394 Z" fill="#2E74A6" />
                  </g>

                  <line x1="101" y1="0" x2="101" y2="400" stroke="#090910" stroke-width="5" />
                  <line x1="199" y1="0" x2="199" y2="400" stroke="#090910" stroke-width="5" />
                  <line x1="0" y1="133" x2="300" y2="133" stroke="#090910" stroke-width="5" />
                  <line x1="0" y1="267" x2="300" y2="267" stroke="#090910" stroke-width="5" />
                </svg>
              </div>
            </div>

            <div class="vf-capsule-live">
              <div class="vf-capsule-meta">
                <span id="capsule-tile-name">Pieza: La aurora</span>
                <span id="capsule-ref">Lamentaciones 3:23</span>
              </div>
              <p class="vf-capsule-verse" id="capsule-text">
                «Su fidelidad es grande; sus misericordias son nuevas cada mañana.»
              </p>
            </div>

            <div class="vf-stage-footer">
              <span>Toca los cuadros oscuros del vitral para encenderlos</span>
              <button type="button" class="vf-reset-btn" id="reset-demo">Reiniciar</button>
            </div>
          </div>
        </div>
      </section>

      <section class="vf-section" id="experiencia">
        <div class="vf-section-tag">Experiencia diaria</div>
        <h2 class="vf-section-heading">Constancia en la Palabra, sin prisa ni culpas.</h2>
        <p class="vf-section-sub">
          Diseñada con la estética cálida del papel de códice y tinta roja de rúbrica, Vitrales de Fe acompaña tu
          ritmo real con recompensas amables y cero presiones artificiales.
        </p>

        <div class="vf-steps-grid">
          <article class="vf-step-card">
            <span class="vf-step-num">1</span>
            <h3>Elige tu estado de ánimo</h3>
            <p>
              Cada día comienza eligiendo cómo te sientes hoy entre cinco emociones. La app selecciona un pasaje
              acorde de su catálogo curado de 75 versículos (y puedes cambiar el texto con un toque).
            </p>
          </article>
          <article class="vf-step-card">
            <span class="vf-step-num">2</span>
            <h3>Descubre la palabra viva</h3>
            <p>
              Completa una palabra clave dentro del versículo para fijar su sentido en tu mente y ganar
              <strong>Puntos de Luz</strong>. Sin temporizadores ni castigos por equivocarte.
            </p>
          </article>
          <article class="vf-step-card">
            <span class="vf-step-num">3</span>
            <h3>Ilumina y guarda tu cápsula</h3>
            <p>
              Un nuevo cuadro de tu vitral cobra color y guarda la fecha, la cita y tu reflexión personal. Y si
              tienes un día ocupado, la <strong>Vela de Vigilia</strong> protege tu racha sin estrés.
            </p>
          </article>
        </div>
      </section>

      <section class="vf-section" id="vitrales">
        <div class="vf-section-tag">Colección completa · 235 piezas</div>
        <h2 class="vf-section-heading">15 vitrales hechos con geometría y color.</h2>
        <p class="vf-section-sub">
          Avanza por 8 vitrales progresivos —desde retículas de 3 × 3 hasta el gran mural de 5 × 5— o canjea tus
          Puntos de Luz en la Tienda por 7 vitrales especiales y 6 marcos arquitectónicos.
        </p>

        <div class="vf-tabs" role="tablist" aria-label="Categorías de vitrales">
          <button type="button" class="vf-tab-btn active" data-filter="progressive" role="tab" aria-selected="true">
            8 Vitrales Progresivos (134 cuadros)
          </button>
          <button type="button" class="vf-tab-btn" data-filter="special" role="tab" aria-selected="false">
            7 Vitrales Especiales de Tienda (101 cuadros)
          </button>
        </div>

        <div class="vf-murals-grid" id="grid-progressive">
          <article class="vf-mural-card">
            <svg class="vf-mural-thumb" viewBox="0 0 120 160" aria-hidden="true">
              <rect width="120" height="160" fill="#1C2E66" />
              <circle cx="60" cy="54" r="24" fill="#F5C451" />
              <path d="M0 108 Q30 96 60 108 T120 108 L120 160 L0 160 Z" fill="#2B5B8E" />
              <path d="M40 0 V160 M80 0 V160 M0 53 H120 M0 106 H120" stroke="#090910" stroke-width="3" />
            </svg>
            <h4>El Alba de la Creación</h4>
            <span class="vf-mural-meta">3 × 3 · 9 cuadros · Inicial</span>
            <p class="vf-mural-theme">La primera luz sobre la faz de las aguas.</p>
          </article>

          <article class="vf-mural-card">
            <svg class="vf-mural-thumb" viewBox="0 0 120 160" aria-hidden="true">
              <rect width="120" height="160" fill="#5D9BE0" />
              <path d="M0 112 Q60 88 120 112 V160 H0 Z" fill="#3E8E5A" />
              <line x1="62" y1="54" x2="54" y2="145" stroke="#8A5524" stroke-width="5" />
              <path d="M62 54 C62 42 78 42 78 54" fill="none" stroke="#8A5524" stroke-width="5" />
              <path d="M40 0 V160 M80 0 V160 M0 40 H120 M0 80 H120 M0 120 H120" stroke="#090910" stroke-width="3" />
            </svg>
            <h4>El Buen Pastor</h4>
            <span class="vf-mural-meta">3 × 4 · 12 cuadros</span>
            <p class="vf-mural-theme">Salmo 23: delicados pastos y aguas de reposo.</p>
          </article>

          <article class="vf-mural-card">
            <svg class="vf-mural-thumb" viewBox="0 0 120 160" aria-hidden="true">
              <rect width="120" height="160" fill="#10183A" />
              <polygon points="55,34 0,10 0,68" fill="#F5C451" opacity="0.7" />
              <polygon points="65,34 120,10 120,68" fill="#F5C451" opacity="0.7" />
              <rect x="48" y="34" width="24" height="92" fill="#D9D2C5" />
              <circle cx="60" cy="34" r="9" fill="#FFE680" />
              <path d="M0 124 Q60 110 120 124 V160 H0 Z" fill="#1A426E" />
              <path d="M30 0 V160 M60 0 V160 M90 0 V160 M0 40 H120 M0 80 H120 M0 120 H120" stroke="#090910" stroke-width="2.5" />
            </svg>
            <h4>Faro de Esperanza</h4>
            <span class="vf-mural-meta">4 × 4 · 16 cuadros</span>
            <p class="vf-mural-theme">Una luz que guía en medio de la noche.</p>
          </article>

          <article class="vf-mural-card">
            <svg class="vf-mural-thumb" viewBox="0 0 120 160" aria-hidden="true">
              <rect width="120" height="160" fill="#23483A" />
              <circle cx="60" cy="54" r="38" fill="#3B8E5B" />
              <circle cx="42" cy="48" r="20" fill="#54B06C" />
              <circle cx="78" cy="48" r="20" fill="#54B06C" />
              <rect x="52" y="76" width="16" height="62" fill="#6E4427" />
              <rect x="0" y="134" width="120" height="26" fill="#2F7AA6" />
              <path d="M30 0 V160 M60 0 V160 M90 0 V160 M0 40 H120 M0 80 H120 M0 120 H120" stroke="#090910" stroke-width="2.5" />
            </svg>
            <h4>El Árbol de la Vida</h4>
            <span class="vf-mural-meta">4 × 4 · 16 cuadros</span>
            <p class="vf-mural-theme">Salmo 1 y Apocalipsis 22: plantado junto a corrientes.</p>
          </article>

          <article class="vf-mural-card">
            <svg class="vf-mural-thumb" viewBox="0 0 120 160" aria-hidden="true">
              <rect width="120" height="160" fill="#355C8C" />
