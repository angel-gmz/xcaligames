    <script>
      const versesByTile = [
        { name: 'El firmamento', ref: 'Salmos 19:1', text: '«Los cielos hablan de la gloria de Dios; los cielos anuncian la obra de sus manos.»' },
        { name: 'El lucero', ref: '2 Pedro 1:19', text: '«Estén atentos hasta que amanezca el día y la estrella de la mañana brille en sus corazones.»' },
        { name: 'La noche que se va', ref: 'Salmos 30:5', text: '«El llanto puede durar toda la noche, pero la alegría llega con la mañana.»' },
        { name: 'La aurora', ref: 'Lamentaciones 3:23', text: '«Su fidelidad es grande; sus misericordias son nuevas cada mañana.»' },
        { name: 'La luz', ref: 'Génesis 1:3', text: '«Entonces Dios dijo: “¡Que haya luz!”, y hubo luz.»' },
        { name: 'El resplandor', ref: 'Juan 8:12', text: '«Yo soy la luz del mundo. El que me sigue no caminará en oscuridad.»' },
        { name: 'Las aguas', ref: 'Salmos 23:2', text: '«Me da descanso en verdes pastos. Me guía a corrientes tranquilas.»' },
        { name: 'El reflejo', ref: 'Salmos 36:9', text: '«Porque tú eres la fuente de vida; en tu luz vemos la luz.»' },
        { name: 'Mar adentro', ref: 'Salmos 139:10', text: '«Incluso allí me guiará tu mano; tu mano derecha me sostendrá.»' },
      ];

      const tiles = Array.from(document.querySelectorAll('#demo-mural-svg .vf-mural-tile'));
      const counterEl = document.getElementById('demo-counter');
      const nameEl = document.getElementById('capsule-tile-name');
      const refEl = document.getElementById('capsule-ref');
      const textEl = document.getElementById('capsule-text');
      const resetBtn = document.getElementById('reset-demo');

      function updateCounter() {
        if (!counterEl) return;
        const lit = tiles.filter((t) => t.classList.contains('vf-tile-lit')).length;
        counterEl.textContent = `${lit} / ${tiles.length} cuadros`;
      }

      tiles.forEach((tile) => {
        tile.addEventListener('click', () => {
          const idx = Number(tile.getAttribute('data-tile') || '0');
          tile.classList.remove('vf-tile-dark');
          tile.classList.add('vf-tile-lit');
          const data = versesByTile[idx] || versesByTile[0];
          if (nameEl) nameEl.textContent = `Pieza: ${data.name}`;
          if (refEl) refEl.textContent = data.ref;
          if (textEl) textEl.textContent = data.text;
          updateCounter();
        });
      });

      resetBtn?.addEventListener('click', () => {
        tiles.forEach((tile, idx) => {
          tile.classList.toggle('vf-tile-lit', idx < 4);
          tile.classList.toggle('vf-tile-dark', idx >= 4);
        });
        const initial = versesByTile[3];
        if (nameEl) nameEl.textContent = `Pieza: ${initial.name}`;
        if (refEl) refEl.textContent = initial.ref;
        if (textEl) textEl.textContent = initial.text;
        updateCounter();
      });

      const tabButtons = document.querySelectorAll('.vf-tab-btn');
      const gridProg = document.getElementById('grid-progressive');
      const gridSpec = document.getElementById('grid-special');

      tabButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const mode = btn.getAttribute('data-filter');
          tabButtons.forEach((b) => {
            const active = b === btn;
            b.classList.toggle('active', active);
            b.setAttribute('aria-selected', String(active));
          });
          gridProg?.classList.toggle('vf-hidden', mode !== 'progressive');
          gridSpec?.classList.toggle('vf-hidden', mode !== 'special');
        });
      });

      const postcardThemes: Record<string, {
        bgTop: string; bgBot: string; outer: string; inner: string; verse: string;
        ref: string; ver: string; badgeBg: string; badgeBorder: string; brand: string;
        sub: string; petals: string[];
      }> = {
        nocturno: {
          bgTop: '#0B0E1D',
          bgBot: '#171C36',
          outer: '#D4A446',
          inner: 'rgba(212,164,70,0.42)',
          verse: '#FAF4E6',
          ref: '#F5C451',
          ver: '#A8B0CC',
          badgeBg: 'rgba(255,248,236,0.08)',
          badgeBorder: 'rgba(245,196,81,0.45)',
          brand: '#F5C451',
          sub: '#E5DEC9',
          petals: ['#D94B43', '#3E7BFA', '#F5C451', '#2E9E73', '#9B5DE5', '#E87A3D'],
        },
        pergamino: {
          bgTop: '#FCF8EE',
          bgBot: '#EDE1C9',
          outer: '#9E2B25',
          inner: 'rgba(158,43,37,0.34)',
          verse: '#221C18',
          ref: '#9E2B25',
          ver: '#6E6358',
          badgeBg: 'rgba(158,43,37,0.07)',
          badgeBorder: 'rgba(158,43,37,0.32)',
          brand: '#9E2B25',
          sub: '#433932',
          petals: ['#B83B35', '#2D60C8', '#D9A21B', '#2B7A58', '#7B3FA0', '#C95C2B'],
        },
        aurora: {
          bgTop: '#1D1128',
          bgBot: '#35192B',
          outer: '#E8BA73',
          inner: 'rgba(232,186,115,0.42)',
          verse: '#FFF6EA',
          ref: '#F6C87E',
          ver: '#D2B8C6',
          badgeBg: 'rgba(255,246,234,0.08)',
          badgeBorder: 'rgba(246,200,126,0.45)',
          brand: '#F6C87E',
          sub: '#F1DFDF',
          petals: ['#E05A6D', '#8C62D6', '#F5C451', '#E8854B', '#48A9A6', '#D45D89'],
        },
      };

      const rosetteGroup = document.getElementById('pc-rosette');
      const petalPolygons: { poly: SVGPolygonElement; colorIndex: number }[] = [];

      if (rosetteGroup) {
        for (let i = 0; i < 12; i += 1) {
          const angle = (i / 12) * Math.PI * 2 - Math.PI / 2;
          const half = (Math.PI / 12) * 0.86;
          const midR = 26 + (104 - 26) * 0.56;
          const pts = [
            [540 + Math.cos(angle) * 26, 224 + Math.sin(angle) * 26],
            [540 + Math.cos(angle - half) * midR, 224 + Math.sin(angle - half) * midR],
            [540 + Math.cos(angle) * 104, 224 + Math.sin(angle) * 104],
            [540 + Math.cos(angle + half) * midR, 224 + Math.sin(angle + half) * midR],
          ];
          const poly = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
          poly.setAttribute('points', pts.map((p) => `${p[0].toFixed(1)},${p[1].toFixed(1)}`).join(' '));
          poly.setAttribute('stroke', '#090910');
          poly.setAttribute('stroke-width', '4');
          poly.setAttribute('stroke-linejoin', 'round');
          rosetteGroup.appendChild(poly);
          petalPolygons.push({ poly, colorIndex: i % 6 });
        }
      }

      function applyPostcardTheme(id: string) {
        const t = postcardThemes[id] || postcardThemes.nocturno;
        document.getElementById('pc-stop-top')?.setAttribute('stop-color', t.bgTop);
        document.getElementById('pc-stop-bot')?.setAttribute('stop-color', t.bgBot);
        document.getElementById('pc-frame-outer')?.setAttribute('stroke', t.outer);
        document.getElementById('pc-frame-inner')?.setAttribute('stroke', t.inner);
        document.getElementById('pc-div1')?.setAttribute('stroke', t.inner);
        document.getElementById('pc-div2')?.setAttribute('stroke', t.inner);
        document.getElementById('pc-div3')?.setAttribute('stroke', t.inner);
        document.getElementById('pc-diamond')?.setAttribute('fill', t.outer);
        ['pc-v1', 'pc-v2', 'pc-v3'].forEach((vid) => document.getElementById(vid)?.setAttribute('fill', t.verse));
        document.getElementById('pc-ref')?.setAttribute('fill', t.ref);
        document.getElementById('pc-ver')?.setAttribute('fill', t.ver);
        document.getElementById('pc-badge')?.setAttribute('fill', t.badgeBg);
        document.getElementById('pc-badge')?.setAttribute('stroke', t.badgeBorder);
        document.getElementById('pc-brand')?.setAttribute('fill', t.brand);
        document.getElementById('pc-sub')?.setAttribute('fill', t.sub);
        petalPolygons.forEach(({ poly, colorIndex }) => poly.setAttribute('fill', t.petals[colorIndex]));
      }

      applyPostcardTheme('nocturno');
      document.querySelectorAll('.vf-theme-chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          document.querySelectorAll('.vf-theme-chip').forEach((c) => c.classList.toggle('active', c === chip));
          applyPostcardTheme(chip.getAttribute('data-theme') || 'nocturno');
        });
      });
    </script>

