        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .vf-stat-num {
        font-family: var(--vf-display);
        font-size: 24px;
        color: var(--vf-gold);
      }

      .vf-stat-label {
        font-size: 13px;
        color: #b7b3a9;
        margin-top: 2px;
      }

      .vf-stage {
        background: rgba(10, 12, 24, 0.65);
        border: 1px solid rgba(245, 196, 81, 0.3);
        border-radius: 26px;
        padding: 22px;
        box-shadow: 0 28px 60px rgba(0, 0, 0, 0.45);
      }

      .vf-stage-header {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin-bottom: 14px;
      }

      .vf-stage-title {
        font-family: var(--vf-serif);
        font-size: 20px;
        color: #fff8ec;
      }

      .vf-stage-counter {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--vf-gold);
      }

      .vf-arch-frame {
        border-radius: 180px 180px 14px 14px;
        padding: 10px;
        background: linear-gradient(145deg, #b4862b, #f7d77e 50%, #9b701d);
      }

      .vf-arch-inner {
        border-radius: 170px 170px 10px 10px;
        overflow: hidden;
        background: var(--vf-lead);
        border: 3px solid var(--vf-lead);
      }

      #demo-mural-svg {
        display: block;
        width: 100%;
        height: auto;
      }

      .vf-mural-tile {
        cursor: pointer;
        transition: opacity 0.22s ease, filter 0.22s ease;
      }

      .vf-mural-tile:hover {
        filter: brightness(1.16);
      }

      .vf-tile-dark {
        opacity: 0.2;
        filter: saturate(0.25) brightness(0.45);
      }

      .vf-tile-lit {
        opacity: 1;
        filter: saturate(1.12) brightness(1.04);
      }

      .vf-capsule-live {
        margin-top: 14px;
        padding: 14px 16px;
        border-radius: 14px;
        background: rgba(255, 248, 236, 0.06);
        border: 1px solid rgba(245, 196, 81, 0.22);
      }

      .vf-capsule-meta {
        display: flex;
        justify-content: space-between;
        font-size: 12.5px;
        color: var(--vf-gold);
        margin-bottom: 6px;
        font-weight: 700;
      }

      .vf-capsule-verse {
        font-family: var(--vf-serif);
        font-size: 16.5px;
        line-height: 1.45;
        color: #faf4e6;
      }

      .vf-stage-footer {
        margin-top: 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12.5px;
        color: #aba69c;
      }

      .vf-reset-btn {
        background: transparent;
        border: 1px solid rgba(255, 248, 236, 0.25);
        color: #faf4e6;
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 12.5px;
        cursor: pointer;
      }

      .vf-section {
        max-width: 1120px;
        margin: 0 auto;
        padding: 76px 24px;
      }

      .vf-section + .vf-section {
        border-top: 1px solid var(--vf-line);
      }

      .vf-section-tag {
        font-size: 12.5px;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--vf-accent);
        margin-bottom: 10px;
      }

      .vf-section-heading {
        font-family: var(--vf-serif);
        font-size: clamp(28px, 3.6vw, 40px);
        line-height: 1.15;
        font-weight: 400;
        color: var(--vf-ink);
        margin-bottom: 14px;
        max-width: 680px;
      }

      .vf-section-sub {
        font-size: 17px;
        color: var(--vf-ink-soft);
        max-width: 660px;
        margin-bottom: 36px;
      }

      .vf-steps-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
      }

      .vf-step-card {
        background: var(--vf-aisle);
        border: 1px solid var(--vf-line);
        border-radius: 16px;
        padding: 26px;
        display: flex;
        flex-direction: column;
        gap: 12px;
      }

      .vf-step-num {
        display: inline-flex;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--vf-accent-wash);
        border: 1px solid var(--vf-accent);
        color: var(--vf-accent);
        font-family: var(--vf-serif);
        font-size: 18px;
        align-items: center;
        justify-content: center;
      }

      .vf-step-card h3 {
        font-family: var(--vf-serif);
        font-size: 22px;
        color: var(--vf-ink);
        font-weight: 500;
      }

      .vf-step-card p {
        font-size: 15.5px;
        color: var(--vf-ink-soft);
      }

      .vf-tabs {
        display: inline-flex;
        padding: 4px;
        border-radius: 16px;
        background: var(--vf-raised);
        border: 1px solid var(--vf-line);
        margin-bottom: 28px;
        gap: 4px;
        flex-wrap: wrap;
      }

      .vf-tab-btn {
        border: none;
        background: transparent;
        color: var(--vf-ink-soft);
        font-size: 14px;
        font-weight: 700;
        padding: 9px 16px;
        border-radius: 12px;
        cursor: pointer;
      }

      .vf-tab-btn.active {
        background: var(--vf-accent);
        color: var(--vf-on-accent);
      }

      .vf-murals-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
      }

      .vf-mural-card {
        background: var(--vf-aisle);
        border: 1px solid var(--vf-line);
        border-radius: 16px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }

      .vf-mural-thumb {
        width: 100%;
        aspect-ratio: 3 / 4;
        border-radius: 10px;
        border: 2px solid var(--vf-lead);
        background: var(--vf-lead);
      }

      .vf-mural-card h4 {
        font-family: var(--vf-serif);
        font-size: 18px;
        color: var(--vf-ink);
        font-weight: 500;
      }

      .vf-mural-meta {
        font-size: 13px;
        color: var(--vf-ink-muted);
      }

      .vf-mural-theme {
        font-size: 13.5px;
        color: var(--vf-ink-soft);
        line-height: 1.45;
      }

      .vf-hidden {
        display: none !important;
      }

      .vf-split-feature {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 40px;
        align-items: center;
      }

      .vf-feature-list {
        list-style: none;
        display: grid;
        gap: 14px;
        padding: 0;
      }

      .vf-feature-list li {
        padding-left: 22px;
        position: relative;
        font-size: 16px;
        color: var(--vf-ink-soft);
      }

      .vf-feature-list li::before {
        content: '';
        position: absolute;
        left: 0;
        top: 9px;
        width: 8px;
        height: 8px;
        transform: rotate(45deg);
        background: var(--vf-accent);
      }

      .vf-feature-list strong {
        color: var(--vf-ink);
      }

      .vf-postcard-showcase {
        background: var(--vf-aisle);
        border: 1px solid var(--vf-line-strong);
        border-radius: 24px;
        padding: 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
      }

      .vf-postcard-preview {
        width: 100%;
        max-width: 310px;
        aspect-ratio: 4 / 5;
        border-radius: 14px;
        overflow: hidden;
        border: 1px solid var(--vf-line-strong);
        box-shadow: 0 18px 40px rgba(34, 28, 24, 0.16);
      }

      .vf-theme-switcher {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: center;
      }

      .vf-theme-chip {
        border: 1px solid var(--vf-line-strong);
        background: var(--vf-nave);
        color: var(--vf-ink-soft);
        padding: 7px 14px;
        border-radius: 999px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
      }

      .vf-theme-chip.active {
        border-color: var(--vf-accent);
        background: var(--vf-accent-wash);
        color: var(--vf-accent);
      }

      .vf-callout-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
        gap: 24px;
      }

      .vf-callout-box {
        background: var(--vf-aisle);
        border: 1px solid var(--vf-line-strong);
        border-radius: 24px;
        padding: 32px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 18px;
      }

      .vf-callout-dark {
        background: linear-gradient(155deg, var(--vf-night), var(--vf-night-deep));
        color: #faf4e6;
        border-color: rgba(245, 196, 81, 0.28);
      }

      .vf-callout-dark p {
        color: #d0cabf;
      }

      .vf-btn-link {
        display: inline-flex;
        align-items: center;
        font-weight: 700;
        font-size: 15px;
        color: var(--vf-accent);
      }

      .vf-callout-dark .vf-btn-link {
        color: var(--vf-gold);
      }

      .vf-footer {
        border-top: 1px solid var(--vf-line);
        background: var(--vf-aisle);
        padding: 34px 24px;
      }

      .vf-footer-inner {
        max-width: 1120px;
        margin: 0 auto;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        font-size: 14px;
        color: var(--vf-ink-soft);
      }

      .vf-footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
      }

      @media (max-width: 960px) {
        .vf-hero-inner,
        .vf-split-feature,
        .vf-callout-grid {
          grid-template-columns: 1fr;
        }

        .vf-murals-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .vf-steps-grid {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .vf-nav a:not(.vf-nav-cta) {
          display: none;
        }

        .vf-murals-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </body>
</html>
