---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (
  await getCollection('blog', ({ data }) => {
    return import.meta.env.PROD ? data.draft !== true : true;
  })
).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }).format(date);

const getReadingMinutes = (body?: string) => {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 200));
};
---

<BaseLayout
  title="Devlog de Xcali Games | Torchbound y Vector//Protocol"
  description="Diario de desarrollo de Xcali Games: arquitectura de Torchbound, el demo táctico Vector//Protocol, avances de Riserift y notas técnicas."
>
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 lg:px-8">
    <header class="max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.2em] text-gold">Notas técnicas y lanzamientos</p>
      <h1 class="mt-2 text-5xl leading-tight text-parchment sm:text-6xl">Devlog de Xcali Games</h1>
      <p class="mt-4 text-xl leading-relaxed text-ash">
        Documentamos cómo diseñamos y programamos nuestros juegos independientes desde México: motores ligeros en Three.js y WebGL2, simulación determinista de reglas, audio generado por código y herramientas web sin fricción.
      </p>
      <p class="mt-3 text-lg leading-relaxed text-ash/85">
        Aquí publicamos las novedades de <strong class="text-parchment">Torchbound</strong> (nuestro solitario de mazmorra para Android), los lanzamientos de juegos demo en navegador como <strong class="text-parchment">Vector//Protocol</strong> y los avances de desarrollo de <strong class="text-parchment">Riserift</strong>. Cada entrada explica las decisiones de diseño, las mecánicas jugables y los detalles técnicos que hacen que funcionen rápido en móvil y escritorio.
      </p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="https://vector.xcaligames.cloud/" target="_blank" rel="noopener noreferrer" class="btn-vector inline-flex min-h-11 items-center rounded-full px-5 text-base font-extrabold transition">
          Probar demo de Vector//Protocol
        </a>
        <a href="/#torchbound" class="inline-flex min-h-11 items-center rounded-full border border-line px-5 text-base font-bold text-parchment transition hover:border-gold hover:text-gold">
          Conocer Torchbound
        </a>
        <a href="/rss.xml" class="inline-flex min-h-11 items-center rounded-full border border-line px-5 text-base font-bold text-ash transition hover:border-gold hover:text-gold">
          Suscribirse por RSS
        </a>
      </div>
    </header>

    <div class="mt-12 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post, index) => (
        <article class="relative flex flex-col overflow-hidden rounded-2xl border border-line bg-crypt transition hover:border-gold/60">
          <div class="overflow-hidden">
            <Image
              src={post.data.heroImage}
              alt={post.data.heroImageAlt}
              width={600}
              height={315}
              format="webp"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              class="h-52 w-full object-cover"
            />
          </div>
          <div class="flex flex-1 flex-col p-6">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[15px] text-ash/80">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              <span aria-hidden="true">&middot;</span>
              <span>{getReadingMinutes(post.body)} min de lectura</span>
            </div>
            <h2 class="mt-2 text-xl leading-snug text-parchment">
              <a href={`/blog/${post.id}`} class="after:absolute after:inset-0 hover:text-gold">{post.data.title}</a>
            </h2>
            <p class="mt-3 flex-1 leading-relaxed text-ash">{post.data.description}</p>
            {post.data.tags.length > 0 && (
              <ul class="mt-4 flex flex-wrap gap-2" aria-label="Etiquetas del artículo">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <li class="rounded-full border border-line bg-crypt-2 px-2.5 py-0.5 text-xs font-bold text-ash/90">
                    #{tag}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
