---
import SEOHead, { type Props as SEOProps } from '../components/SEOHead.astro';
import '../styles/global.css';

export interface Props extends SEOProps {}

const props = Astro.props;
const currentPath = Astro.url.pathname;
const PLAY_URL = 'https://play.google.com/store/apps/details?id=com.xcaligames.torchbound';
const nav = [
  { href: '/#torchbound', label: 'Torchbound', active: false },
  { href: '/#riserift', label: 'Riserift', active: false },
  { href: '/blog', label: 'Devlog', active: currentPath.startsWith('/blog') },
];
---

<!doctype html>
<html lang="es-MX">
  <head>
    <SEOHead {...props} />
  </head>
  <body class="bg-dungeon min-h-screen flex flex-col antialiased selection:bg-gold selection:text-night">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-lg focus:bg-gold focus:px-4 focus:py-2 focus:font-bold focus:text-night"
    >
      Saltar al contenido principal
    </a>

    <header class="sticky top-0 z-40 border-b border-line/70 bg-night/85 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6 lg:px-8">
        <a href="/" class="flex items-center gap-3" aria-label="Xcali Games, ir al inicio">
          <img src="/xcali-emblema.svg" alt="" width="44" height="44" class="h-11 w-11" />
          <span class="leading-none">
            <span class="block font-display text-xl text-gold">Xcali</span>
            <span class="block text-[13px] font-bold tracking-[0.3em] text-parchment/80">GAMES</span>
          </span>
        </a>

        <nav aria-label="Navegación principal">
          <ul class="flex items-center gap-1 sm:gap-2 text-[17px] font-bold">
            {nav.map((item) => (
              <li class="hidden sm:block">
                <a
                  href={item.href}
                  aria-current={item.active ? 'page' : undefined}
                  class:list={[
                    'rounded-lg px-3 py-2.5 transition-colors hover:text-gold',
                    item.active ? 'text-gold' : 'text-ash',
                  ]}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a
                href={PLAY_URL}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-ember inline-flex min-h-11 items-center rounded-full px-5 text-[16px] font-extrabold transition"
              >
                Jugar gratis
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <footer class="border-t border-line/70 bg-[#07080E] py-14 text-ash">
      <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-4 sm:px-6 md:grid-cols-12 lg:px-8">
        <div class="md:col-span-6">
          <a href="/" class="flex items-center gap-3" aria-label="Xcali Games, ir al inicio">
            <img src="/xcali-emblema.svg" alt="" width="40" height="40" class="h-10 w-10" />
            <span class="font-display text-xl text-gold">Xcali Games</span>
          </a>
          <p class="mt-4 max-w-sm leading-relaxed">
            Estudio independiente en México. Hacemos juegos de cartas y mazmorras para jugar en partidas cortas.
          </p>
        </div>

        <div class="md:col-span-3">
          <h2 class="font-display text-base text-parchment">Juegos</h2>
          <ul class="mt-3 space-y-2">
            <li><a href={PLAY_URL} target="_blank" rel="noopener noreferrer" class="hover:text-gold">Torchbound en Google Play</a></li>
            <li><a href="/#riserift" class="hover:text-rift">Riserift (en desarrollo)</a></li>
          </ul>
        </div>

        <div class="md:col-span-3">
          <h2 class="font-display text-base text-parchment">Estudio</h2>
          <ul class="mt-3 space-y-2">
            <li><a href="/blog" class="hover:text-gold">Devlog</a></li>
            <li><a href="/rss.xml" class="hover:text-gold">RSS</a></li>
          </ul>
        </div>
      </div>
      <p class="mx-auto mt-12 max-w-6xl px-4 text-sm text-ash/70 sm:px-6 lg:px-8">
        &copy; {new Date().getFullYear()} Xcali Games. Torchbound está basado en Scoundrel, de Zach Gage y Kurt Bieg.
      </p>
    </footer>
  </body>
</html>
