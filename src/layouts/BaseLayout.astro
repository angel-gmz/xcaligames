---
import SEOHead, { type Props as SEOProps } from '../components/SEOHead.astro';
import '../styles/global.css';

export interface Props extends SEOProps {}

const props = Astro.props;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es-MX">
  <head>
    <SEOHead {...props} />
  </head>
  <body class="bg-gamer-grid min-h-screen flex flex-col text-slate-100 antialiased selection:bg-[#ff5500] selection:text-slate-950">
    <!-- Accesibilidad: Saltar al contenido principal -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[#ff5500] focus:px-4 focus:py-2 focus:font-bold focus:text-slate-950"
    >
      Saltar al contenido principal
    </a>

    <!-- Barra Superior de Telemetría Gamer (HUD Status Strip) -->
    <div class="border-b border-slate-800/80 bg-[#030407] px-4 py-1.5 text-[11px] font-mono tracking-wider text-slate-400">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 text-emerald-400 font-semibold">
            <span class="h-2 w-2 rounded-full bg-emerald-400 animate-pulse"></span>
            REALM: ONLINE
          </span>
          <span class="hidden sm:inline text-slate-700">|</span>
          <span class="hidden sm:inline">STUDIO: <strong class="text-slate-200">XCALIGAMES</strong></span>
          <span class="hidden md:inline text-slate-700">|</span>
          <span class="hidden md:inline">TARGET: <strong class="text-[#ff5500]">60 FPS MOBILE &amp; PC</strong></span>
        </div>
        <div class="flex items-center gap-4">
          <a
            href="/#torchbound"
            class="text-amber-400 hover:text-amber-300 transition-colors font-semibold"
          >
            [01] TORCHBOUND: LIVE
          </a>
          <a
            href="/#riserift"
            class="text-[#00e5ff] hover:text-sky-300 transition-colors font-semibold"
          >
            [02] RISERIFT: WIP
          </a>
        </div>
      </div>
    </div>

    <!-- Cabecera Semántica Estilo Command Deck -->
    <header class="sticky top-0 z-40 border-b border-slate-800/90 bg-[#05060a]/90 backdrop-blur-md">
      <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6 lg:px-8">
        <a
          href="/"
          class="group flex items-center gap-3 text-xl font-bold tracking-tight text-white transition-colors"
          aria-label="XcaliGames - Ir al inicio"
        >
          <span class="hud-btn flex h-10 w-10 items-center justify-center bg-gradient-to-br from-amber-400 via-[#ff5500] to-red-600 text-slate-950 font-black text-lg shadow-lg shadow-orange-500/25 group-hover:scale-105 transition-transform">
            X
          </span>
          <div class="flex flex-col">
            <span class="font-display text-lg font-black tracking-wider uppercase leading-none">
              XCALI<span class="text-[#ff5500]">GAMES</span>
            </span>
            <span class="font-mono text-[10px] tracking-widest text-slate-400">
              INDIE GAME STUDIO
            </span>
          </div>
        </a>

        <nav aria-label="Navegación principal">
          <ul class="flex items-center gap-4 sm:gap-7 text-sm font-semibold">
            <li>
              <a
                href="/"
                aria-current={currentPath === '/' ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-[#ff5500]',
                  currentPath === '/' ? 'text-[#ff5500]' : 'text-slate-300',
                ]}
              >
                Base
              </a>
            </li>
            <li>
              <a
                href="/#juegos"
                class="text-slate-300 transition-colors hover:text-[#ff5500]"
              >
                Arsenal de Juegos
              </a>
            </li>
            <li>
              <a
                href="/blog"
                aria-current={currentPath.startsWith('/blog') ? 'page' : undefined}
                class:list={[
                  'transition-colors hover:text-[#00e5ff]',
                  currentPath.startsWith('/blog')
                    ? 'text-[#00e5ff]'
                    : 'text-slate-300',
                ]}
              >
                Devlog &amp; Patch Notes
              </a>
            </li>
            <li class="hidden sm:block">
              <a
                href="https://play.google.com/store/apps/details?id=com.xcaligames.torchbound"
                target="_blank"
                rel="noopener noreferrer"
                class="hud-btn inline-flex items-center gap-2 bg-[#ff5500] px-4 py-2 text-xs font-black uppercase tracking-wider text-slate-950 transition hover:bg-amber-400"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 0 1-.61-.92V2.734a1 1 0 0 1 .609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 0 1 0 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.8 8.99l-2.302 2.302-8.634-8.634z"/>
                </svg>
                Jugar Torchbound
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Pie de Página Semántico Gamer -->
    <footer class="border-t border-slate-800/90 bg-[#030407] py-14 text-sm text-slate-400">
      <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
          <div class="md:col-span-5">
            <div class="flex items-center gap-3">
              <span class="hud-btn flex h-8 w-8 items-center justify-center bg-[#ff5500] text-slate-950 font-black">
                X
              </span>
              <span class="font-display text-lg font-black tracking-wider text-white uppercase">
                XCALI<span class="text-[#ff5500]">GAMES</span>
              </span>
            </div>
            <p class="mt-3 max-w-sm text-slate-400 leading-relaxed">
              Forjando mundos oscuros y acción dimensional sin concesiones. Creadores de <strong class="text-amber-400">Torchbound</strong> en Android y arquitectos de <strong class="text-[#00e5ff]">Riserift</strong>.
            </p>
            <p class="mt-4 font-mono text-xs text-slate-400">
              DOMAIN // <span class="text-slate-200">xcaligames.cloud</span>
            </p>
          </div>

          <div class="md:col-span-4">
            <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-[#ff5500]">
              // MUNDOS ACTIVOS
            </h2>
            <ul class="mt-4 space-y-2.5">
              <li>
                <a
                  href="https://play.google.com/store/apps/details?id=com.xcaligames.torchbound"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-slate-300 hover:text-amber-400 transition-colors"
                >
                  <span class="h-1.5 w-1.5 bg-[#ff5500]"></span>
                  Torchbound — Google Play Store
                </a>
              </li>
              <li>
                <a
                  href="/#riserift"
                  class="inline-flex items-center gap-2 text-slate-300 hover:text-[#00e5ff] transition-colors"
                >
                  <span class="h-1.5 w-1.5 bg-[#00e5ff]"></span>
                  Riserift — En Desarrollo Activo
                </a>
              </li>
            </ul>
          </div>

          <div class="md:col-span-3">
            <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-[#00e5ff]">
              // RED &amp; SINDICACIÓN
            </h2>
            <ul class="mt-4 space-y-2.5">
              <li>
                <a href="/blog" class="text-slate-300 hover:text-white transition-colors">
                  Bitácora de Desarrollo (Devlog)
                </a>
              </li>
              <li>
                <a href="/rss.xml" class="text-slate-300 hover:text-white transition-colors">
                  Canal RSS (XML Feed)
                </a>
              </li>
              <li>
                <a href="/sitemap-index.xml" class="text-slate-300 hover:text-white transition-colors">
                  Mapa de Sectores (Sitemap)
                </a>
              </li>
            </ul>
          </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between border-t border-slate-800/70 pt-6 font-mono text-xs text-slate-400 sm:flex-row">
          <p>&copy; {new Date().getFullYear()} XCALIGAMES STUDIO. TODOS LOS DERECHOS RESERVADOS.</p>
          <p class="mt-2 sm:mt-0 text-slate-400">
            [ ENGINE: ASTRO 5 SSG &bull; ZERO CLIENT JS &bull; CWV 100/100 ]
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
