---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  tags: string[];
  headings?: MarkdownHeading[];
  rawContent?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags = [],
  headings = [],
  rawContent = '',
} = Astro.props;

// Cálculo de tiempo de lectura estimado (200 palabras por minuto)
const wordCount = rawContent.trim().split(/\s+/).filter(Boolean).length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={heroImage.src}
  publishDate={pubDate}
  modifiedDate={updatedDate}
  tags={tags}
>
  <article class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Migas de Pan (Breadcrumbs) estilo Consola Gamer -->
    <nav aria-label="Breadcrumb" class="mb-6 font-mono text-xs text-slate-400">
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="hover:text-[#ff5500] transition-colors">BASE</a>
        </li>
        <li aria-hidden="true" class="text-slate-600">//</li>
        <li>
          <a href="/blog" class="hover:text-[#00e5ff] transition-colors">DEVLOG</a>
        </li>
        <li aria-hidden="true" class="text-slate-600">//</li>
        <li class="text-amber-300 font-bold truncate max-w-[240px] sm:max-w-md" aria-current="page">
          {title}
        </li>
      </ol>
    </nav>

    <!-- Cabecera del Artículo -->
    <header class="mb-10">
      <div class="mb-4 flex flex-wrap items-center gap-2 font-mono">
        {
          tags.map((tag) => (
            <span class="border border-[#ff5500]/40 bg-[#ff5500]/10 px-2.5 py-0.5 text-xs font-bold text-amber-300">
              #{tag}
            </span>
          ))
        }
      </div>

      <h1 class="font-display text-3xl font-black uppercase tracking-tight text-white sm:text-4xl lg:text-5xl leading-tight">
        {title}
      </h1>

      <p class="mt-4 text-lg text-slate-300 leading-relaxed">
        {description}
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-4 border-y border-slate-800 bg-[#07090f] px-4 py-3 font-mono text-xs text-slate-400">
        <div class="flex items-center gap-1.5">
          <span>PUBLICADO:</span>
          <time datetime={pubDate.toISOString()} class="font-bold text-slate-200">
            {formatDate(pubDate)}
          </time>
        </div>

        {
          updatedDate && (
            <div class="flex items-center gap-1.5">
              <span>| ACTUALIZADO:</span>
              <time datetime={updatedDate.toISOString()} class="font-bold text-amber-300">
                {formatDate(updatedDate)}
              </time>
            </div>
          )
        }

        <div class="flex items-center gap-1.5">
          <span>|</span>
          <span class="text-[#00e5ff] font-bold">TIEMPO DE LECTURA: {readingTimeMinutes} MIN</span>
        </div>
      </div>

      <!-- Hero Image como elemento LCP del artículo (eager + fetchpriority high + CLS = 0) -->
      <figure class="hud-cut mt-8 overflow-hidden border border-slate-700 bg-[#05060a] p-1.5 shadow-2xl">
        <Image
          src={heroImage}
          alt={heroImageAlt}
          width={1200}
          height={630}
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full object-cover"
        />
      </figure>
    </header>

    <!-- Tabla de Contenidos estilo Índice de Misión -->
    {
      tocHeadings.length > 0 && (
        <aside
          aria-label="Tabla de contenidos"
          class="hud-cut mb-10 border border-slate-800 bg-[#0b0e17] p-6"
        >
          <h2 class="font-mono text-xs font-bold uppercase tracking-widest text-[#00e5ff]">
            // ÍNDICE DE LA TRANSMISIÓN
          </h2>
          <ul class="mt-3 space-y-2 text-sm">
            {tocHeadings.map((heading) => (
              <li class={heading.depth === 3 ? 'pl-4' : ''}>
                <a
                  href={`#${heading.slug}`}
                  class="text-slate-300 hover:text-[#ff5500] transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </aside>
      )
    }

    <!-- Cuerpo del Post -->
    <div
      class="prose prose-invert max-w-none space-y-6 text-slate-200 leading-relaxed
             [&_h2]:font-display [&_h2]:mt-10 [&_h2]:mb-4 [&_h2]:text-2xl [&_h2]:font-black [&_h2]:uppercase [&_h2]:text-white [&_h2]:border-l-4 [&_h2]:border-[#ff5500] [&_h2]:pl-3
             [&_h3]:font-display [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-amber-300
             [&_p]:text-base [&_p]:leading-7 [&_p]:text-slate-300
             [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2 [&_ul]:text-slate-300
             [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2 [&_ol]:text-slate-300
             [&_strong]:text-white [&_a]:text-[#ff5500] [&_a]:underline hover:[&_a]:text-amber-300
             [&_blockquote]:border-l-4 [&_blockquote]:border-[#00e5ff] [&_blockquote]:bg-[#0b0e17] [&_blockquote]:px-5 [&_blockquote]:py-3 [&_blockquote]:italic
             [&_code]:bg-slate-800 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:font-mono [&_code]:text-sm [&_code]:text-amber-300
             [&_pre]:overflow-x-auto [&_pre]:border [&_pre]:border-slate-800 [&_pre]:bg-[#05060a] [&_pre]:p-4"
    >
      <slot />
    </div>

    <!-- CTA Final de Artículo hacia los juegos -->
    <footer class="hud-cut glow-torch mt-14 border border-[#ff5500]/50 bg-[#0b0e17] p-8">
      <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <div>
          <p class="font-mono text-xs font-bold uppercase tracking-widest text-amber-400">
            // READY TO PLAY?
          </p>
          <h2 class="mt-1 font-display text-2xl font-black uppercase text-white">
            Entra al calabozo en Torchbound
          </h2>
          <p class="mt-1 text-sm text-slate-300">
            Descarga nuestro juego en Android o explora más transmisiones sobre el desarrollo de <strong>Riserift</strong>.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            href="https://play.google.com/store/apps/details?id=com.xcaligames.torchbound"
            target="_blank"
            rel="noopener noreferrer"
            class="hud-btn bg-[#ff5500] px-5 py-3 text-xs font-black uppercase tracking-wider text-slate-950 transition hover:bg-amber-400"
          >
            Descargar en Google Play
          </a>
          <a
            href="/blog"
            class="hud-btn border border-slate-700 bg-[#05060a] px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:border-[#00e5ff]"
          >
            Más Transmisiones
          </a>
        </div>
      </div>
    </footer>
  </article>
</BaseLayout>
