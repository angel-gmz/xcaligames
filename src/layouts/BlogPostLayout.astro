---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';

export interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  heroImage: ImageMetadata;
  heroImageAlt: string;
  tags: string[];
  headings?: MarkdownHeading[];
  rawContent?: string;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  heroImage,
  heroImageAlt,
  tags = [],
  headings = [],
  rawContent = '',
} = Astro.props;

// Cálculo de tiempo de lectura estimado (200 palabras por minuto)
const wordCount = rawContent.trim().split(/\s+/).filter(Boolean).length;
const readingTimeMinutes = Math.max(1, Math.ceil(wordCount / 200));

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(date);

const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  ogImage={heroImage.src}
  publishDate={pubDate}
  modifiedDate={updatedDate}
  tags={tags}
>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6 lg:px-8">
    <nav aria-label="Ruta de navegación" class="mb-8 text-[15px] text-ash">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="hover:text-gold">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/blog" class="hover:text-gold">Devlog</a></li>
      </ol>
    </nav>

    <header class="mb-10">
      <h1 class="text-4xl leading-tight text-parchment sm:text-5xl">{title}</h1>
      <p class="mt-4 text-xl leading-relaxed text-ash">{description}</p>
      <p class="mt-5 text-[15px] text-ash/80">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>{updatedDate && updatedDate.valueOf() !== pubDate.valueOf() && (<span>, actualizado el <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>)}<span>. Lectura de {readingTimeMinutes} min.</span>
      </p>
      <figure class="mt-8 overflow-hidden rounded-2xl border border-line">
        <Image src={heroImage} alt={heroImageAlt} width={1200} height={630} format="webp" loading="eager" fetchpriority="high" class="h-auto w-full object-cover" />
      </figure>
    </header>

    {tocHeadings.length > 0 && (
      <aside aria-label="Contenido" class="mb-10 rounded-2xl border border-line bg-crypt p-6">
        <h2 class="text-lg text-parchment">En esta entrada</h2>
        <ul class="mt-3 space-y-2">
          {tocHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'pl-4' : ''}>
              <a href={`#${heading.slug}`} class="text-ash hover:text-gold">{heading.text}</a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <div
      class="space-y-6 text-lg leading-8 text-ash
             [&_h2]:mt-12 [&_h2]:mb-4 [&_h2]:font-display [&_h2]:text-3xl [&_h2]:text-parchment
             [&_h3]:mt-8 [&_h3]:mb-3 [&_h3]:font-display [&_h3]:text-2xl [&_h3]:text-gold
             [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-2
             [&_ol]:list-decimal [&_ol]:pl-6 [&_ol]:space-y-2
             [&_strong]:text-parchment [&_a]:text-gold [&_a]:underline [&_a]:underline-offset-4 hover:[&_a]:text-parchment
             [&_blockquote]:border-l-4 [&_blockquote]:border-ember [&_blockquote]:bg-crypt [&_blockquote]:px-5 [&_blockquote]:py-3 [&_blockquote]:italic
             [&_code]:rounded [&_code]:bg-crypt-2 [&_code]:px-1.5 [&_code]:py-0.5 [&_code]:text-base [&_code]:text-gold
             [&_pre]:overflow-x-auto [&_pre]:rounded-xl [&_pre]:border [&_pre]:border-line [&_pre]:bg-night [&_pre]:p-4"
    >
      <slot />
    </div>

    <footer class="mt-16 rounded-3xl border border-gold/40 bg-crypt p-8">
      <h2 class="text-3xl text-parchment">Juega el reto de hoy</h2>
      <p class="mt-2 text-lg text-ash">Torchbound es gratis en Android. La mazmorra de hoy es la misma para todo el mundo.</p>
      <div class="mt-6 flex flex-wrap gap-4">
        <a href="https://play.google.com/store/apps/details?id=com.xcaligames.torchbound" target="_blank" rel="noopener noreferrer" class="btn-ember inline-flex min-h-12 items-center rounded-full px-6 font-extrabold transition">
          Descargar en Google Play
        </a>
        <a href="/blog" class="inline-flex min-h-12 items-center rounded-full border border-line px-6 font-bold text-parchment transition hover:border-gold hover:text-gold">
          Más entradas
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
